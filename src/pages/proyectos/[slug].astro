---
import Layout from "@layouts/Layout.astro";
import { caseStudies } from "../../data/caseStudies";

export function getStaticPaths() {
  return Object.keys(caseStudies).map((slug) => ({
    params: { slug },
    props: { caseStudy: caseStudies[slug as keyof typeof caseStudies] },
  }));
}

const { caseStudy } = Astro.props;
const pageUrl = Astro.url.href;
const caseStudySchema = {
  "@type": "CreativeWork",
  "@id": `${pageUrl}#case-study`,
  "name": caseStudy.title,
  "headline": caseStudy.title,
  "description": caseStudy.intro,
  "url": pageUrl,
  "image": new URL(caseStudy.image, Astro.site ?? Astro.url).href,
  "creator": { "@id": "https://jgferreccior-dev.github.io/#person" },
  "about": caseStudy.organization,
  "keywords": caseStudy.skills,
  "isPartOf": {
    "@type": "WebSite",
    "@id": "https://jgferreccior-dev.github.io/#website",
  },
};
---

<Layout
  title={`${caseStudy.title} — José Gerardo Ferreccio Riega`}
  description={caseStudy.intro}
  structuredData={caseStudySchema}
>
  <article class="py-14 md:py-24">
    <div class="mb-10 flex items-center justify-between gap-4 md:mb-14">
      <a
        href="/#projects"
        class="inline-flex items-center gap-2 rounded-full border border-white/10 px-4 py-2 text-sm font-medium text-neutral transition hover:border-white/20 hover:text-white focus:outline-none focus:ring-2 focus:ring-primary"
      >
        ← Volver a proyectos
      </a>
      <span class="hidden text-xs font-semibold uppercase tracking-[0.18em] text-white/40 sm:block">Caso de estudio</span>
    </div>

    <header class="relative overflow-hidden rounded-3xl border border-white/10 bg-[#101720] px-6 py-10 md:px-12 md:py-14">
      <div class="absolute -right-24 -top-24 h-64 w-64 rounded-full bg-primary/10 blur-3xl" aria-hidden="true"></div>
      <div class="relative max-w-4xl">
        <p class="mb-5 text-xs font-semibold uppercase tracking-[0.2em] text-primary">{caseStudy.eyebrow}</p>
        <h1 class="font-serif text-4xl font-bold leading-tight tracking-tightest text-white sm:text-5xl md:text-7xl">{caseStudy.title}</h1>
        <p class="mt-6 max-w-3xl text-base leading-8 text-neutral md:text-xl">{caseStudy.intro}</p>

        <div class="mt-8 grid max-w-3xl gap-4 border-t border-white/10 pt-6 sm:grid-cols-2">
          <div>
            <p class="mb-1 text-[10px] font-semibold uppercase tracking-[0.18em] text-white/40">Rol</p>
            <p class="text-sm font-medium text-white md:text-base">{caseStudy.role}</p>
          </div>
          <div>
            <p class="mb-1 text-[10px] font-semibold uppercase tracking-[0.18em] text-white/40">Periodo</p>
            <p class="text-sm font-medium text-white md:text-base">{caseStudy.period}</p>
          </div>
        </div>

        <div class="mt-5 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-white/60">
          <span>{caseStudy.organization}</span>
          <span class="hidden text-white/20 sm:inline">•</span>
          <span>Digital Media & SEO</span>
        </div>
      </div>
    </header>

    <div class="mt-6 overflow-hidden rounded-3xl border border-white/10 bg-[#151b24] shadow-2xl shadow-black/20 md:mt-8">
      <img
        src={caseStudy.image}
        alt={`Vista del proyecto ${caseStudy.title}`}
        class="h-auto w-full"
        width="1200"
        height="700"
        loading="eager"
        fetchpriority="high"
      />
    </div>

    <div class="my-10 grid grid-cols-2 gap-px overflow-hidden rounded-2xl border border-white/10 bg-white/10 md:my-14 md:grid-cols-4">
      {caseStudy.metrics.map(([value, label]) => (
        <div class="bg-[#0b1118] p-5 md:p-7">
          <p class="font-serif text-3xl font-bold tracking-tight text-white md:text-5xl">{value}</p>
          <p class="mt-2 text-xs leading-6 text-neutral md:text-sm">{label}</p>
        </div>
      ))}
    </div>

    <div class="grid gap-12 md:grid-cols-[minmax(0,1fr)_280px] md:gap-20">
      <div class="space-y-14 md:space-y-16">
        <section>
          <p class="mb-3 text-xs font-semibold uppercase tracking-[0.18em] text-primary">01 · El reto</p>
          <h2 class="mb-5 font-serif text-3xl font-semibold tracking-tight text-white md:text-4xl">Objetivo y contexto</h2>
          <p class="max-w-3xl text-base leading-8 text-neutral md:text-lg">{caseStudy.challenge}</p>
        </section>

        <section>
          <p class="mb-3 text-xs font-semibold uppercase tracking-[0.18em] text-primary">02 · El enfoque</p>
          <h2 class="mb-6 font-serif text-3xl font-semibold tracking-tight text-white md:text-4xl">Estrategia y ejecución</h2>
          <ul class="max-w-3xl space-y-4">
            {caseStudy.approach.map((item) => (
              <li class="relative pl-7 text-base leading-8 text-neutral before:absolute before:left-0 before:top-0.5 before:font-semibold before:text-primary before:content-['→']">{item}</li>
            ))}
          </ul>
        </section>

        <section class="rounded-2xl border border-white/10 bg-[#101720] p-6 md:p-8">
          <p class="mb-3 text-xs font-semibold uppercase tracking-[0.18em] text-primary">03 · Resultados</p>
          <h2 class="mb-5 font-serif text-3xl font-semibold tracking-tight text-white md:text-4xl">Impacto</h2>
          <p class="max-w-3xl text-base leading-8 text-neutral md:text-lg">{caseStudy.results}</p>
        </section>
      </div>

      <aside class="h-fit rounded-2xl border border-white/10 bg-[#0b1118] p-6 md:sticky md:top-28">
        <p class="mb-4 text-xs font-semibold uppercase tracking-[0.18em] text-primary">Especialidades</p>
        <p class="text-sm leading-7 text-white/80">{caseStudy.skills}</p>
        <div class="mt-7 border-t border-white/10 pt-6">
          <p class="mb-3 text-xs uppercase tracking-[0.16em] text-white/40">Referencia</p>
          <a
            href={caseStudy.reference}
            target="_blank"
            rel="noreferrer"
            class="text-sm font-semibold text-white transition hover:text-primary focus:outline-none focus:ring-2 focus:ring-primary"
          >
            Ver sitio de referencia ↗
          </a>
        </div>
      </aside>
    </div>


    {Astro.params.slug === "activa-capital" && (
      <section id="galeria" class="mt-14 md:mt-20" aria-labelledby="gallery-title">
        <div class="mb-8">
          <p class="mb-3 text-xs font-semibold uppercase tracking-[0.18em] text-primary">Archivo de publicaciones · Activa Capital</p>
          <h2 id="gallery-title" class="font-serif text-3xl font-semibold text-white md:text-5xl">Galería de contenido real</h2>
          <p class="mt-4 max-w-3xl text-sm leading-7 text-neutral md:text-base">
            Selección de publicaciones originales enlazadas a las redes de Activa Capital, identificadas en la auditoría de julio a septiembre de 2026. Se presentan como referencias del ecosistema de contenidos analizado; su inclusión no implica autoría individual ni resultados atribuibles a mi gestión. Las creatividades producidas posteriormente se incorporarán con sus archivos o enlaces verificados.
          </p>
        </div>
        {[
          { category: "Reels", items: [
            { title: "Liquidez para negocios", detail: "Contenido de financiamiento con narrativa orientada a necesidades empresariales.", url: "https://www.instagram.com/reel/DcqyRhpkeKY/" },
            { title: "Emprendimiento: historia de Araceli", detail: "Entrevista vertical sobre el recorrido de una emprendedora.", url: "https://www.instagram.com/reel/Db1kbASiMHV/" },
            { title: "Finanzas para empresarios", detail: "Pieza educativa con enfoque en conocimiento financiero.", url: "https://www.instagram.com/reel/DbRQFXlj_zM/" },
          ]},
          { category: "Campañas publicitarias", items: [
            { title: "Financiamiento en Chincha", detail: "Creatividad geolocalizada para préstamos con garantía de propiedad. No se dispone del reporte de anuncios de esta pieza.", url: "https://www.instagram.com/reel/DboMGpOEVQu/" },
            { title: "Campaña por Fiestas Patrias", detail: "Contenido comercial estacional orientado al crecimiento de negocios; no se atribuye rendimiento pagado.", url: "https://www.instagram.com/reel/DbGZgqHDziZ/" },
          ]},
          { category: "Carruseles", items: [
            { title: "Cinco señales de falta de liquidez", detail: "Carrusel educativo sobre gestión financiera empresarial.", url: "https://www.instagram.com/p/DbuKrKPmYEy/" },
            { title: "¿Conviene endeudarse?", detail: "Contenido explicativo que vincula financiamiento y objetivos.", url: "https://www.instagram.com/p/DbEAG5Zj76b/" },
            { title: "Clientes y proyectos", detail: "Secuencia de prueba social y comunicación de marca.", url: "https://www.instagram.com/p/Dco2k0EAXnL/" },
          ]},
          { category: "ADN Emprendedor", items: [
            { title: "Invitados de ADN Emprendedor", detail: "Carrusel que presenta a los participantes del formato de entrevistas.", url: "https://www.instagram.com/p/DbgilBHjuM0/" },
            { title: "Entrevista: Fanny Huapaya", detail: "Historia personal y emprendimiento en formato reel.", url: "https://www.instagram.com/reel/Da6IesHkbHr/" },
          ]},
        ].map((group) => (
          <div class="mb-12">
            <h3 class="mb-5 border-b border-white/10 pb-3 font-serif text-2xl font-semibold text-white">{group.category}</h3>
            <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
              {group.items.map((item) => (
                <a href={item.url} target="_blank" rel="noopener noreferrer" class="group flex min-h-48 flex-col justify-between rounded-2xl border border-white/10 bg-[#101720] p-6 transition hover:border-primary/60 hover:bg-[#14202a] focus:outline-none focus:ring-2 focus:ring-primary">
                  <div>
                    <p class="mb-4 text-[11px] font-semibold uppercase tracking-[0.15em] text-primary">{group.category} · Instagram</p>
                    <h4 class="font-serif text-xl font-semibold text-white group-hover:text-primary">{item.title}</h4>
                    <p class="mt-3 text-sm leading-6 text-neutral">{item.detail}</p>
                  </div>
                  <span class="mt-6 text-sm font-semibold text-primary">Ver publicación original ↗</span>
                </a>
              ))}
            </div>
          </div>
        ))}
      </section>
    )}

    <div class="mt-16 flex flex-col gap-4 border-t border-white/10 pt-8 sm:flex-row sm:items-center sm:justify-between md:mt-20">
      <a href="/#projects" class="text-sm font-semibold text-white transition hover:text-primary focus:outline-none focus:ring-2 focus:ring-primary">← Explorar más proyectos</a>
      <a href="/#contact" class="text-sm font-semibold text-primary transition hover:text-white focus:outline-none focus:ring-2 focus:ring-primary">Hablemos →</a>
    </div>
  </article>
</Layout>
